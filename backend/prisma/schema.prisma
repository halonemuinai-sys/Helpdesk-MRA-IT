datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  AGENT
  ADMIN
  AUDITOR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CompanyMaster {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  sector        String           // GENERAL, FB, RADIO, RETAIL, MEDIA
  sharedBudget  Float            @default(0) // Budget for shared/branch devices (monthly)
  createdAt     DateTime         @default(now())
  companies     Company[]        // Branches belonging to this master company
  subscriptions ITSubscription[] // Subscriptions belonging to this master company
  assets        Asset[]          // Assets leased by this master company
  peripheralAssets PeripheralAsset[]
}

model Company {
  id              Int              @id @default(autoincrement())
  name            String           // Clean company name (e.g., PT Hourlogy Indah Perkasa)
  location        String           // Branch/Location detail (e.g., Butik OMEGA Plaza Indonesia or HQ)
  sector          String           // FB, RADIO, MEDIA, RETAIL, GENERAL
  createdAt       DateTime         @default(now())
  users           User[]
  tickets         Ticket[]
  wifiAPs         WifiAccessPoint[]
  assets          Asset[]          // Assets allocated at this physical branch
  peripheralAssets PeripheralAsset[]
  
  // Link to master company
  companyMasterId Int?
  companyMaster   CompanyMaster?   @relation(fields: [companyMasterId], references: [id])

  @@unique([name, location])
}

model User {
  id           String    @id // Employee ID (e.g., '40822045')
  email        String    @unique
  password     String
  name         String
  department   String    // Organization (e.g., 'Finance & Accounting')
  jobPosition  String    // Job Position (e.g., 'Operational Staff')
  phone        String?   // Mobile Phone
  monthlyBudget Float     @default(0) // Monthly rental budget in IDR
  role         Role      @default(USER)
  companyId    Int
  company      Company   @relation(fields: [companyId], references: [id])
  createdAt    DateTime  @default(now())
  
  requestedTickets Ticket[] @relation("RequesterTickets")
  assignedTickets  Ticket[] @relation("AssignedTickets")
  assets           Asset[]  // Assets currently assigned to this employee
  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  handledApprovals   ApprovalRequest[] @relation("HandledApprovals")

  @@index([companyId])
  @@index([role])
  @@index([department])
}

model Ticket {
  id                 String       @id @default(uuid())
  title              String
  description        String
  category           String       // Hardware, Software, Network, Access
  subCategory        String?      @default("-") // Detailing of category (e.g., Printer, Email, Wi-Fi)
  source             String       @default("Walk-in") // Walk-in, Email, Phone Call, Instant Messaging, Direct Instruction, On-site Visit, System Alert
  status             TicketStatus @default(OPEN)
  priority           Priority     @default(LOW)
  
  companyId          Int
  company            Company      @relation(fields: [companyId], references: [id])
  
  requesterId        String
  requester          User         @relation("RequesterTickets", fields: [requesterId], references: [id])
  
  assignedToId       String?
  assignedTo         User?        @relation("AssignedTickets", fields: [assignedToId], references: [id])
  
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  
  // SLA tracking
  slaResponseLimit   DateTime     // Target timestamp for first response
  slaResolutionLimit DateTime     // Target timestamp for resolution
  respondedAt        DateTime?    // Actual timestamp of first response
  resolvedAt         DateTime?    // Actual timestamp of resolution
  isSlaBreached      Boolean      @default(false)
  
  // SLA pause support
  lastPausedAt       DateTime?    // Timestamp when moved to PENDING
  totalPausedMs      Int          @default(0) // Accumulated pause time in milliseconds
  
  auditLogs          AuditLog[]

  @@index([companyId])
  @@index([requesterId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g., "TICKET_CREATED", "STATUS_CHANGED", "ASSIGNED"
  details     String   // Change detail description
  performedBy String   // User name or ID who performed the action
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model CategoryMetadata {
  id          Int      @id @default(autoincrement())
  category    String   // e.g., Hardware, Software, Network, Access
  subCategory String   // e.g., Printer, Outlook Webmail
  brands      String[] @default([])
  createdAt   DateTime @default(now())

  @@unique([category, subCategory])
  @@index([category])
}

model WifiAccessPoint {
  id            String   @id @default(uuid())
  bssid         String   @unique
  ssid          String
  password      String?  @default("")
  location      String
  ipAddress     String?
  vendor        String?
  modelName     String?
  frequency     String   @default("5GHz")
  channel       Int?
  securityType  String   @default("WPA2-Enterprise")
  status        String   @default("ACTIVE")
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([ssid])
}

model ITSubscription {
  id                      String           @id @default(uuid())
  category                String           // e.g. "Hosting", "Domain", "VPN", "ISP", "Subscription", "Others"
  vendor                  String           // Penyedia jasa (e.g. Google, Niagahoster)
  name                    String           // Nama layanan / Domain (e.g. "Google Workspace", "mra.co.id")
  billingCycle            String           // Siklus penagihan: "1 Bulan", "3 Bulan", "6 Bulan", "1 Tahun", "2 Tahun", "3 Tahun"
  cost                    Float            // Biaya layanan dalam Rupiah (e.g. 150000)
  startDate               DateTime         // Tanggal mulai aktif kontrak
  expiryDate              DateTime         // Tanggal akhir aktif kontrak (kedaluwarsa)
  status                  String           @default("ACTIVE") // Status: "ACTIVE" (Aktif), "EXPIRED" (Kedaluwarsa), "INACTIVE" (Tidak Aktif)
  evidenceLink            String?          // URL Link bukti pembayaran/kontrak (Google Drive, dll.)
  notes                   String?          // Catatan tambahan (IP, Akun Admin, dll.)
  journey                 String?          @default("") // Akumulasi log catatan pembaruan teks
  renewals                RenewalHistory[] // Relasi historis perpanjangan
  
  // Relasi ke Master Company (Company Entity Tagging)
  companyMasterId         Int?
  companyMaster           CompanyMaster?   @relation(fields: [companyMasterId], references: [id])

  // Chaining/Silsilah Kontrak untuk Kasus Kontrak Baru (Replacement)
  replacedSubscriptionId  String?          @unique
  replacedSubscription    ITSubscription?  @relation("SubscriptionReplacement", fields: [replacedSubscriptionId], references: [id])
  replacedBySubscription  ITSubscription?  @relation("SubscriptionReplacement")
 
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([companyMasterId])
  @@index([category])
  @@index([status])
  @@index([expiryDate])
}

model RenewalHistory {
  id             String         @id @default(uuid())
  subscriptionId String
  subscription   ITSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  renewedAt      DateTime       @default(now())
  cost           Float          // Biaya perpanjangan saat tindakan dilakukan
  period         String         // Durasi perpanjangan (e.g., "1 Tahun")
  notes          String?        // Catatan perpanjangan (e.g., "Diperpanjang 2 tahun per 6 bulan (Rp 300rb)")
}

model Asset {
  id              String        @id @default(uuid())
  assetTag        String        @unique // e.g. AST-MRA-0001
  
  // References
  deviceRef       String?       @unique // e.g. LP10682 (Device code/ID for damage reports)
  vendorRef       String?       // e.g. ASN/20240318/1621/0001 (Payment/Billing unit code)
  vendor          String?       // Vendor name (e.g. PT Teknologi Skoring Nusantara, Javarent)
  
  // Specifications
  brand           String        // e.g. Lenovo, Dell, HP, Apple
  model           String        // e.g. ThinkPad L14 Gen 2
  processor       String?       // e.g. Intel Core i5
  ram             String?       // e.g. 8GB, 16GB
  storage         String?       // e.g. 256GB SSD, 512GB SSD
  os              String?       // e.g. Windows 11 Pro, macOS
  office          String?       // e.g. Microsoft Office 2021 H&B, M365
  
  // Ownership details (focused on Rental/Sewa)
  ownershipType   String        @default("RENTAL") // RENTAL, OWNED
  status          String        @default("AVAILABLE") // AVAILABLE, ASSIGNED, MAINTENANCE, DISPOSED
  
  // Cost & Rental Schedules
  rentalCost      Float         // Monthly rental fee in IDR
  rentalStart     DateTime      // Lease start date
  rentalEnd       DateTime      // Lease end date
  
  notes           String?       // Additional remarks
  journey         String?       @default("") // Timeline of handovers, returns, and repairs
  
  // Relations
  userId          String?       // Employee ID utilizing the device
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  companyId       Int?          // Physical office location branch
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  companyMasterId Int?          // Legal master company owning the lease contract
  companyMaster   CompanyMaster? @relation(fields: [companyMasterId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([companyMasterId])
  @@index([status])
}

model ApprovalRequest {
  id            String   @id @default(uuid())
  entityType    String   // "ASSET", "SUBSCRIPTION", "WIFI_AP", "CATEGORY"
  entityId      String
  entityName    String   // e.g., "AST-MRA-0001" or "Google Workspace"
  reason        String?  // Reason for delete written by Agent
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes    String?  // Admin review notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Requesting Agent
  requestedById String
  requestedBy   User     @relation("RequestedApprovals", fields: [requestedById], references: [id], onDelete: Cascade)

  // Reviewing Admin
  handledById   String?
  handledBy     User?    @relation("HandledApprovals", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
}

model SystemAuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g. "ASSET_CREATE", "ASSET_DELETE_REQUESTED", "ASSET_DELETED", etc.
  details     String   // Description of changes/parameters
  performedBy String   // Agent/Admin name and email
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model PeripheralAsset {
  id              String         @id @default(uuid())
  name            String         // e.g. "Hikvision Dome Camera 4MP"
  category        String         // e.g. "CCTV", "NVR", "STORAGE", "NETWORK", "POWER", "PERIPHERAL"
  brand           String         // e.g. "Hikvision", "Seagate", "TP-Link", "APC"
  model           String?        // e.g. "DS-2CD2143G0-I"
  serialNumber    String?        // Serial number or serial ranges (Optional)
  purchaseCost    Float          // Price per unit in IDR
  quantity        Int            @default(1) // Number of items bought
  totalCost       Float          // Total cost: purchaseCost * quantity
  purchaseDate    DateTime       // Date bought
  warrantyExpiry  DateTime?      // Warranty end date (Optional)
  supplier        String?        // Vendor / Shop where bought (Optional)
  invoiceRef      String?        // Invoice number (Optional)
  poRef           String?        // Purchase Order number (Optional)
  status          String         @default("STOCK") // STATUS: STOCK, IN_USE, DAMAGED, RETIRED
  notes           String?        // Additional description or serials checklist
  
  // Placement branch (e.g. Wisma MRA Floor 3, Butik Plaza Indonesia)
  companyId       Int?
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Finance entity paying for it (e.g. PT Mugi Rekso Abadi)
  companyMasterId Int?
  companyMaster   CompanyMaster? @relation(fields: [companyMasterId], references: [id], onDelete: SetNull)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([category])
  @@index([status])
  @@index([companyId])
  @@index([companyMasterId])
}

model PeripheralCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  brands    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
