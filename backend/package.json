{
  "name": "helpdesk-backend",
  "version": "1.0.0",
  "description": "Backend API for IT Helpdesk MRA Group",
  "main": "api/index.js",
  "scripts": {
    "dev": "nodemon api/index.js",
    "start": "node api/index.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.js",
    "sewa:clean": "python prisma/process_sewa.py",
    "sewa:import": "node prisma/import_cleaned_assets.js",
    "sewa:pipeline": "python prisma/process_sewa.py && node prisma/import_cleaned_assets.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.10",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0"
  }
}
